<style>
    #chat-fab { position: fixed; bottom: 24px; right: 24px; width: 56px; height: 56px; border-radius: 50%; border: 0;
                background: #212529; color: #fff; font-size: 24px; box-shadow: 0 4px 12px rgba(0,0,0,.3); z-index: 1050; cursor: pointer; }
    #chat-panel { position: fixed; bottom: 92px; right: 24px; width: 340px; max-width: calc(100vw - 32px); height: 460px; max-height: calc(100vh - 120px);
                  background: #fff; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,.25); display: none; flex-direction: column; overflow: hidden; z-index: 1050; }
    #chat-panel.abierto { display: flex; }
    #chat-head { background: #212529; color: #fff; padding: 12px 16px; font-weight: 700; display: flex; justify-content: space-between; align-items: center; }
    #chat-head button { background: none; border: 0; color: #fff; font-size: 20px; cursor: pointer; }
    #chat-msgs { flex: 1; overflow-y: auto; padding: 12px; background: #f8f9fa; }
    .chat-m { max-width: 85%; padding: 8px 12px; border-radius: 12px; margin-bottom: 8px; font-size: .9rem; white-space: pre-wrap; word-wrap: break-word; }
    .chat-m.bot { background: #e9ecef; color: #212529; }
    .chat-m.yo { background: #0d6efd; color: #fff; margin-left: auto; }
    #chat-form { display: flex; gap: 6px; padding: 10px; border-top: 1px solid #dee2e6; background: #fff; }
    #chat-input { flex: 1; }
</style>

<button id="chat-fab" type="button" aria-label="Abrir asistente">💬</button>

<div id="chat-panel" role="dialog" aria-label="Asistente virtual">
    <div id="chat-head"><span>Asistente Guereritos</span><button type="button" id="chat-cerrar" aria-label="Cerrar">×</button></div>
    <div id="chat-msgs"></div>
    <form id="chat-form">
        <input id="chat-input" class="form-control form-control-sm" type="text" maxlength="500" placeholder="Escribe tu pregunta..." autocomplete="off" />
        <button class="btn btn-dark btn-sm" type="submit" id="chat-enviar">Enviar</button>
    </form>
</div>

<script>
(function () {
    const fab = document.getElementById('chat-fab');
    const panel = document.getElementById('chat-panel');
    const msgs = document.getElementById('chat-msgs');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const btn = document.getElementById('chat-enviar');
    const historial = [];

    function agregar(texto, clase) {
        const d = document.createElement('div');
        d.className = 'chat-m ' + clase;
        d.textContent = texto;          // textContent evita inyectar HTML
        msgs.appendChild(d);
        msgs.scrollTop = msgs.scrollHeight;
        return d;
    }

    fab.addEventListener('click', () => {
        panel.classList.toggle('abierto');
        if (panel.classList.contains('abierto') && msgs.children.length === 0) {
            agregar('¡Hola! Soy el asistente de Cellphones Guereritos. Pregúntame por celulares, precios o accesorios.', 'bot');
        }
        if (panel.classList.contains('abierto')) input.focus();
    });
    document.getElementById('chat-cerrar').addEventListener('click', () => panel.classList.remove('abierto'));

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const texto = input.value.trim();
        if (!texto) return;
        input.value = '';
        agregar(texto, 'yo');
        const espera = agregar('Escribiendo...', 'bot');
        btn.disabled = true;
        try {
            const r = await fetch('/Chat/Preguntar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mensaje: texto, historial: historial.slice(-6) })
            });
            const data = await r.json();
            espera.textContent = data.respuesta || 'Sin respuesta.';
            historial.push({ role: 'user', text: texto }, { role: 'model', text: espera.textContent });
        } catch {
            espera.textContent = 'No pude conectarme. Intenta de nuevo.';
        } finally {
            btn.disabled = false;
            msgs.scrollTop = msgs.scrollHeight;
            input.focus();
        }
    });
})();
</script>
