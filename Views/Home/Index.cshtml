@{ ViewData["Title"] = "Inicio"; }

<div class="container-fluid p-0 mb-5">
    <div class="text-white text-center py-5 shadow" style="background: url('https://images.unsplash.com/photo-1616348436168-de43ad0db179?q=80&w=2000&auto=format&fit=crop') center/cover;">
        <div class="py-5" style="background: rgba(0,0,0,0.6); padding: 40px; border-radius: 10px; margin: 0 20px;">
            <h1 class="display-4 fw-bold mb-3">El Futuro en tus Manos</h1>
            <p class="lead mb-4 fw-light">Encuentra los mejores smartphones, tablets y accesorios.</p>
            <a href="/Home/Catalogo" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm fw-bold">Ver Todo el Catalogo</a>
        </div>
    </div>
</div>

<div class="container mb-5">
    <h3 class="fw-bold mb-4 border-bottom pb-2 text-dark">Explora por Categorias</h3>
    <div class="row g-4">
        <!-- Tarjeta 1 -->
        <div class="col-md-6 col-lg-3">
            <div class="card text-white h-100 border-0 shadow-sm overflow-hidden">
                <img src="https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?q=80&w=500&auto=format&fit=crop" class="card-img" alt="Premium" style="height: 100%; object-fit: cover;">
                <div class="card-img-overlay d-flex flex-column justify-content-center text-center" style="background: rgba(0,0,0,0.7);">
                    <h4 class="fw-bold">Gama Premium</h4>
                    <p class="text-light small">Maximo rendimiento.</p>
                    <a href="/Home/Catalogo?idCategoria=1" class="btn btn-outline-light mt-2 px-4 mx-auto">Explorar</a>
                </div>
            </div>
        </div>
        <!-- Tarjeta 2 -->
        <div class="col-md-6 col-lg-3">
            <div class="card text-white h-100 border-0 shadow-sm overflow-hidden">
                <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?q=80&w=500&auto=format&fit=crop" class="card-img" alt="Medio" style="height: 100%; object-fit: cover;">
                <div class="card-img-overlay d-flex flex-column justify-content-center text-center" style="background: rgba(13, 110, 253, 0.8);">
                    <h4 class="fw-bold">Calidad - Precio</h4>
                    <p class="text-light small">El mejor equilibrio.</p>
                    <a href="/Home/Catalogo?idCategoria=2" class="btn btn-light text-primary fw-bold mt-2 px-4 mx-auto">Explorar</a>
                </div>
            </div>
        </div>
        <!-- Tarjeta Gama de Entrada -->
        <div class="col-md-6 col-lg-3">
            <div class="card text-white h-100 border-0 shadow-sm overflow-hidden bg-success" style="min-height: 320px;">
                <div class="card-img-overlay d-flex flex-column justify-content-center text-center">
                    <h4 class="fw-bold">Gama de Entrada</h4>
                    <p class="text-light small">Lo mas accesible.</p>
                    <a href="/Home/Catalogo?idCategoria=3" class="btn btn-light text-success fw-bold mt-2 px-4 mx-auto">Explorar</a>
                </div>
            </div>
        </div>
        <!-- Tarjeta 3 -->
        <div class="col-md-6 col-lg-3">
            <div class="card text-white h-100 border-0 shadow-sm overflow-hidden">
                <img src="https://images.unsplash.com/photo-1605464315542-bda3e2f4e605?q=80&w=500&auto=format&fit=crop" class="card-img" alt="Accesorios" style="height: 100%; object-fit: cover;">
                <div class="card-img-overlay d-flex flex-column justify-content-center text-center" style="background: rgba(0,0,0,0.7);">
                    <h4 class="fw-bold">Accesorios</h4>
                    <p class="text-light small">Fundas y smartwatches.</p>
                    <a href="/Home/Catalogo?idCategoria=4" class="btn btn-outline-light mt-2 px-4 mx-auto">Explorar</a>
                </div>
            </div>
        </div>
    </div>
</div>