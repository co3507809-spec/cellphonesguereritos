@{ ViewData["Title"] = "Mi Perfil"; }

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- Tarjeta de Perfil -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-3 text-center p-4">
                <div class="mb-3">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 80px; height: 80px; font-size: 2rem;">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper())
                    </div>
                </div>
                <h5 class="fw-bold mb-1">@User.Identity?.Name</h5>
                <p class="text-muted small">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</p>
                <span class="badge bg-dark mb-3">Rol: @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</span>
                <hr>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-dark btn-sm">Editar Perfil</button>
                    <a asp-controller="Home" asp-action="Logout" class="btn btn-outline-danger btn-sm fw-bold">Cerrar Sesion</a>
                </div>
            </div>
        </div>

        <!-- Panel de Actividad -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark">Historial de Compras</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-borderless table-striped mb-0">
                        <thead class="border-bottom">
                            <tr>
                                <th class="py-3 ps-4">Orden</th>
                                <th class="py-3">Fecha</th>
                                <th class="py-3">Total</th>
                                <th class="py-3">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4 fw-bold">#ORD-9912</td>
                                <td class="text-muted">15 Oct 2026</td>
                                <td class="fw-bold text-success">$21,999.00</td>
                                <td><span class="badge bg-success">Entregado</span></td>
                            </tr>
                            <tr>
                                <td class="ps-4 fw-bold">#ORD-8823</td>
                                <td class="text-muted">02 Sep 2026</td>
                                <td class="fw-bold text-success">$6,500.00</td>
                                <td><span class="badge bg-success">Entregado</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>