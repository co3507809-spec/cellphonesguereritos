@{ ViewData["Title"] = "Terminos y Privacidad"; }

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-dark display-6">Aviso de Privacidad</h2>
                <p class="text-muted">Transparencia y seguridad en el manejo de tus datos.</p>
            </div>

            <div class="card border-0 shadow-sm p-5 rounded-3 bg-white">
                <h5 class="fw-bold text-primary mb-3">1. Recopilacion de Datos</h5>
                <p class="text-muted mb-4 text-justify" style="line-height: 1.8;">
                    Al utilizar los servicios de Cellphones Guereritos, almacenamos unicamente la informacion estrictamente necesaria para procesar las ordenes de compra, generar comprobantes fiscales y coordinar logistica de envios.
                </p>

                <h5 class="fw-bold text-primary mb-3">2. Uso de la Informacion</h5>
                <div class="bg-light p-4 rounded mb-4">
                    <ul class="text-muted mb-0" style="line-height: 1.8;">
                        <li>Autenticacion y proteccion de tu cuenta.</li>
                        <li>Procesamiento de pagos a traves de pasarelas seguras.</li>
                        <li>Soporte tecnico y garantia de equipos de comunicacion.</li>
                    </ul>
                </div>

                <h5 class="fw-bold text-primary mb-3">3. Proteccion Criptografica</h5>
                <p class="text-muted mb-5 text-justify" style="line-height: 1.8;">
                    Todo trafico dentro de nuestro portal esta protegido. Las contraseñas en la base de datos se encuentran encriptadas de extremo a extremo, garantizando que el personal interno no tenga acceso a credenciales en texto plano.
                </p>

                <div class="border-top pt-4 text-center">
                    <p class="text-muted small fw-bold mb-0">Documento actualizado para auditoria: Octubre 2026.</p>
                </div>
            </div>
        </div>
    </div>
</div>